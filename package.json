{
  "name": "@soulwasted/omnisearch",
  "version": "0.1.0",
  "description": "Framework-agnostic Cmd+K command palette with a thin React adapter. Zero runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "Josef Strapáč",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soulwasted/omnisearch.git"
  },
  "keywords": ["command-palette", "cmdk", "omnisearch", "search", "react", "web"],
  "files": ["dist", "README.md", "LICENSE"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test && bun run build",
    "demo": "bun run build && bun run scripts/serve.ts"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  }
}
